# URL publica do front (usada em links/redirects absolutos, quando necessario)
VITE_APP_URL=http://localhost:5173

# URL base da API REST, ex.: https://api.exemplo.com/api/v1
VITE_API_URL=

# Token JWT usado enquanto nao houver fluxo de login (dev/demo)
VITE_JWT_TOKEN=dev-token

# Forca o uso dos dados mockados mesmo com VITE_API_URL definido
VITE_USE_MOCK=true

# Intervalo do carrossel automatico entre abas, em milissegundos
VITE_CAROUSEL_INTERVAL_MS=20000
